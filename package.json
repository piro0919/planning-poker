  "name": "planning-poker2",
  "private": true,
  "scripts": {
    "build": "next build --webpack",
    "build-with-analyze": "ANALYZE=true next build --webpack",
    "dev": "next dev --webpack",
    "lint": "eslint src",
    "lint:es": "eslint src",
    "lint:style": "stylelint --fix '**/*.scss'",
    "prepare": "npx husky install",
    "prettier": "prettier --write src",
    "start": "next start",
    "stylelint-check": "stylelint-config-prettier-scss-check",
    "type-check": "tsc --noemit",
    "lighthouse": "pnpm build && lhci autorun",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "worker:type-check": "tsc -p worker/tsconfig.json",
    "lint:worker": "eslint worker",
    "test": "vitest run"
  },
  "version": "0.1.0",
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260930.2",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
