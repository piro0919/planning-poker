{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "planning-poker-rooms",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "Room"
      }
    ]
  },
  "exports": {
    "Room": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://planning-poker.kkweb.io,http://localhost:3000,https://planning-poker-*-kkweb.vercel.app"
  }
}
